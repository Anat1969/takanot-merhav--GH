  "rules": {
    "2.03": {
      "title": "גובה מינימלי של חלקי בנין",
      "kind": "דרישה מדידה",
      "scene": "room",
      "body": [
        "גובה חדר מגורים, מפני הרצפה ועד פני התקרה, לא יפחת מ־{room_height_min}.",
        "לחלקי בניין אחרים, כמו חדרי שירות ומרתפים, נקבעים גבהים נפרדים בסעיף. יש לבדוק בנוסח."
      ],
      "keywords": [
        "גובה",
        "תקרה",
        "חדר",
        "דירה",
        "גובה קומה",
        "גובה חדר"
      ]
    },
    "2.04": {
      "title": "שטח מינימלי של חלקי בנין ורוחב מינימלי בין קירות",
      "kind": "דרישה מדידה",
      "scene": "room",
      "body": [
        "שטח רצפת חדר מגורים לא יפחת מ־{room_area_min}, והמרחק בין קירות מקבילים לא יפחת מ־{room_width_min}.",
        "הסעיף כולל טבלה לפי סוג החדר. התמצית מציגה שורה אחת בלבד."
      ],
      "keywords": [
        "שטח",
        "רוחב",
        "חדר",
        "קירות",
        "מידות חדר",
        "מינימום"
      ]
    },
    "2.21": {
      "title": "גודל חלונות בדירה",
      "kind": "דרישה מדידה",
      "scene": "window",
      "body": [
        "שטח החלונות בחדר מגורים לא יפחת מ־{window_ratio_min} משטח רצפת החדר.",
        "המודל מחשב את שטח החלון הנדרש מתוך שטח רצפה לדוגמה."
      ],
      "keywords": [
        "חלון",
        "חלונות",
        "תאורה",
        "אור",
        "איוור",
        "פתח"
      ]
    },
    "4.03": {
      "title": "בליטות המותרות מבנין",
      "kind": "מגבלה מדידה",
      "scene": "balcony",
      "body": [
        "מרפסת זיזית רשאית לבלוט מעבר לקו הבניין אל המרווח עד {balcony_ratio_max} מרוחב המרווח, ובלבד שלא תעלה על {balcony_abs_max}.",
        "הסעיף מונה בליטות נוספות (כרכובים, גגונים, אדניות). בגרסה זו מוצגת המרפסת בלבד."
      ],
      "keywords": [
        "מרפסת",
        "בליטה",
        "זיזית",
        "מרווח",
        "קו בניין",
        "חזית"
      ]
    },
    "3.2.2.5": {
      "title": "מידות רום ושלח מדרגה",
      "kind": "דרישה מדידה",
      "scene": "stairs",
      "body": [
        "רום המדרגה (הגובה) לא יעלה על {riser_max}, ושלח המדרגה (העומק) לא יפחת מ־{tread_min}.",
        "הסעיף קובע גם יחס בין הרום לשלח ומידות לפי סוג הבניין. יש לבדוק בנוסח."
      ],
      "keywords": [
        "מדרגה",
        "מדרגות",
        "רום",
        "שלח",
        "גובה מדרגה",
        "עומק מדרגה"
      ]
    },
    "3.2.2.4": {
      "title": "גובה מזקף ראש מעל מדרגות",
      "kind": "דרישה מדידה",
      "scene": "stairs",
      "body": [
        "הגובה הפנוי מעל קו אפי המדרגות לא יפחת מ־{headroom_min}."
      ],
      "keywords": [
        "מזקף ראש",
        "גובה פנוי",
        "מדרגות",
        "תקרה"
      ]
    },
    "3.2.2.6": {
      "title": "מספר המדרגות במהלך אחד",
      "kind": "מגבלה מדידה",
      "scene": "stairs",
      "body": [
        "מספר המדרגות במהלך אחד, בין שני משטחים אופקיים, לא יעלה על {steps_per_flight_max}."
      ],
      "keywords": [
        "מהלך",
