    "3.2.1.3": {
      "title": "רוחב הפתח המינימלי של דלתות",
      "kind": "דרישה מדידה",
      "scene": "door",
      "body": [
        "רוחב הפתח הפנוי של דלת בדרך מוצא לא יפחת מ־{door_width_min}.",
        "המדידה היא של המעבר הפנוי ולא של כנף הדלת. אופן המדידה בסעיף 3.2.1.2."
      ],
      "keywords": [
        "דלת",
        "דלתות",
